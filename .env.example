DATABASE_URL=postgresql://wars:wars@localhost:5432/wars?schema=public
PORT=3000
WORKER_METRICS_PORT=3001
# Default loopback; use 0.0.0.0 inside Docker containers that publish the port.
WORKER_BIND_HOST=127.0.0.1
REFRESH_INTERVAL_MS=21600000
REFRESH_CONCURRENCY=5
OPEN_METEO_TIMEOUT_MS=5000
COLD_START_TIMEOUT_MS=3000
COLD_START_MAX_CONCURRENT=10
STALE_AFTER_SECONDS=21600
GEOCODE_CACHE_TTL_SECONDS=604800
FORECAST_CACHE_TTL_MS=60000
FORECAST_CACHE_MAX_ENTRIES=256
MAX_TRACKED_LOCATIONS=100
LOG_LEVEL=info
# Comma-separated browser origins; leave empty to disable CORS (recommended for API-only).
ALLOWED_ORIGINS=
# Consumer API key (Authorization: Bearer or X-API-Key). Required when NODE_ENV=production.
API_KEY=
# When set, GET /metrics (and detailed health lastError) require Bearer or X-Metrics-Token.
# Required when NODE_ENV=production.
METRICS_TOKEN=
# Shared throttler storage. Required when NODE_ENV=production.
REDIS_URL=
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60
# Behind a reverse proxy/LB set to 1 (or hop count). Leave empty for local Compose.
TRUST_PROXY=
# GraphQL introspection: true/false. Default off in production, on otherwise.
INTROSPECTION=
